{
  "name": "puntaenblanko",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "frontend": "vite",
    "backend": "node backend/server.js",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "dev:electron": "node dev-electron.js",
    "build": "vite build",
    "lint": "eslint .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.puntaenblanko.pos",
    "productName": "Punta En Blanco",
    "files": [
      "dist/**/*",
      "main.cjs",
      "node_modules/**/*"
    ],
    "extraResources": [
      { "from": "backend", "to": "backend" },
      { "from": "backend/node_modules", "to": "backend/node_modules" }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/minilogo.ico"
    }
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "libphonenumber-js": "^1.12.41",
    "lucide-react": "^0.577.0",
    "mysql2": "^3.19.1",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "react-toastify": "^11.0.5",
    "wait-on": "^9.0.4"
  },
  "devDependencies": {
    "@electron/node-gyp": "^10.2.0-electron.2",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "cross-env": "^10.1.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.0"
  }
}
